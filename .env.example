# Django service
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Local demo uses SQLite. Container deployment sets POSTGRES_HOST and friends.
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_DB=raileta
POSTGRES_USER=raileta
POSTGRES_PASSWORD=replace-me
POSTGRES_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
TESTING=false
CELERY_TASK_ALWAYS_EAGER=false

# Synthetic dated Chennai–Bengaluru demo. Run the setup in docs/corridor-simulation.md.
# Set historical_profiles explicitly only to restore the old aggregate experiment.
RAILETA_DATA_ADAPTER=corridor_simulation
RAILETA_HISTORICAL_MODEL_DIR=data/models/etrain-profiles-v1
RAILETA_REPLAY_INTERVAL_SECONDS=15
CRIS_REST_URL=
RAILETA_ENABLE_PUBLIC_SCRAPING=false
RAILETA_EVENT_STALE_SECONDS=180
RAILETA_WEATHER_INTERVAL_SECONDS=900

# Legacy structured adapters are available only by explicit mode change;
# configure an authorised CRIS JSON URL only when access is approved.
PUBLIC_NTES_URL=
IMD_WEATHER_URL=
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ENABLED=false
RAILETA_STORE_RAW_PAYLOADS=true
RAILETA_RAW_DATA_DIR=data/raw
PUBLIC_RAILYATRI_URL_TEMPLATE=
RAILETA_TRAIN_NUMBERS=12027,12639,12607,12657
RAILETA_COLLECTOR_INTERVAL_SECONDS=15

# Forecast metadata
RAILETA_MODEL_VERSION=demo-event-v1
RAILETA_CONFIDENCE_LEVEL=0.80

# Dated-journey ingestion only. Configure a secret out of band; never expose it to Vite.
RAILETA_JOURNEY_INGEST_TOKEN=
# Optional candidate generation; activation is always a separate reviewed command.
RAILETA_JOURNEY_RETRAIN_ENABLED=false

# Optional browser origins for the local dashboards are handled by the
# dependency-free CORS middleware in raileta_api/middleware.py.
